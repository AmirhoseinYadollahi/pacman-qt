     </item>
     <item>
      <widget class="QLabel" name="mapLabel">
       <property name="styleSheet">
        <string notr="true">/* Map selection label style */
QLabel#mapLabel {
    /* Dark background like the game */
    background-color: #000066;
    
    /* White text */
    color: #FFFFFF;
    
    /* Rounded corners */
    border-radius: 10px;
    
    /* Blue border */
    border: 2px solid #1E90FF;
    
    /* Game-like font */
    font-family: &quot;Arial Black&quot;, sans-serif;
    font-size: 14px;
    font-weight: bold;
    
    /* Padding and alignment */
    padding: 8px 12px;
    qproperty-alignment: AlignCenter;
    
    /* Shadow effect */
    box-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
}

/* When a map is selected */
QLabel#mapLabel[selected=&quot;true&quot;] {
    border-color: #00FF00;  /* Green border when map is selected */
    color: #FFFF00;         /* Yellow text */
}</string>
       </property>
       <property name="text">
        <string>Default Map</string>
       </property>
      </widget>
