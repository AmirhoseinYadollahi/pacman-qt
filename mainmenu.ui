    <layout class="QVBoxLayout" name="verticalLayout">
     <item>
      <widget class="QPushButton" name="playButton">
       <property name="styleSheet">
        <string notr="true">/* Base button style - Pacman yellow */
QPushButton {
    /* Yellow base color like Pacman */
    background-color: #FFFF00;
    
    /* Rounded corners */
    border-radius: 15px;
    
    /* Black border */
    border: 3px solid #000000;
    
    /* Pacman font style */
    font-family: &quot;Arial Black&quot;, sans-serif;
    font-size: 16px;
    font-weight: bold;
    color: #000000;
    
    /* Add some padding */
    padding: 10px 20px;
    
    /* Shadow effect */
    box-shadow: 3px 3px 5px rgba(0, 0, 0, 0.5);
}

/* Hover effect - slightly lighter yellow */
QPushButton:hover {
    background-color: #FFFF66;
}

/* Pressed effect - darker yellow */
QPushButton:pressed {
    background-color: #FFCC00;
    padding-top: 12px;
    padding-bottom: 8px;
    box-shadow: 1px 1px 2px rgba(0, 0, 0, 0.5);
}

/* Special ghost button style */
QPushButton#chooseMapButton {
    background-color: #FF0000;  /* Blinky red */
    color: #FFFFFF;
    border-color: #FFFFFF;     /* White border */
}

QPushButton#chooseMapButton:hover {
    background-color: #FF6666;
}

QPushButton#chooseMapButton:pressed {
    background-color: #CC0000;
}

/* Exit button style */
QPushButton#exitButton {
    background-color: #1E90FF;  /* Dodger blue */
    color: #FFFFFF;
    border-color: #FFFFFF;
}

QPushButton#exitButton:hover {
    background-color: #63B8FF;
}

QPushButton#exitButton:pressed {
    background-color: #1874CD;
}</string>
       </property>
       <property name="text">
        <string>Play</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="chooseMapButton">
       <property name="styleSheet">
